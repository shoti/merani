{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shoti/merani/campaign-record.schema.json",
  "title": "Merani offline campaign record v1",
  "type": "object",
  "required": [
    "schema_version",
    "scenario_id",
    "scenario_version",
    "seed",
    "baseline_sha",
    "candidate_sha",
    "bundle_identity",
    "platform",
    "fixture_manifest",
    "commands",
    "started_at",
    "ended_at",
    "duration_seconds",
    "exit_status",
    "scenario_status",
    "expected",
    "observed",
    "provider_invocation_count"
  ],
  "properties": {
    "schema_version": {"const": "merani-campaign-record-v1"},
    "scenario_id": {"type": "string"},
    "scenario_version": {"type": "integer", "minimum": 1},
    "seed": {"type": "integer"},
    "duration_seconds": {"type": "number", "minimum": 0},
    "exit_status": {"type": "integer"},
    "scenario_status": {"enum": ["passed", "failed"]},
    "provider_invocation_count": {"type": "integer", "minimum": 0},
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "arguments",
          "started_at",
          "ended_at",
          "duration_seconds",
          "exit_status",
          "stdout",
          "stderr",
          "provider_invocations"
        ],
        "properties": {
          "arguments": {"type": "array", "items": {"type": "string"}},
          "started_at": {"type": "string"},
          "ended_at": {"type": "string"},
          "duration_seconds": {"type": "number", "minimum": 0},
          "exit_status": {"type": "integer"},
          "provider_invocations": {"type": "integer", "minimum": 0},
          "stdout": {"$ref": "#/$defs/stream"},
          "stderr": {"$ref": "#/$defs/stream"}
        }
      }
    },
    "fixture_manifest": {"type": "array"}
  },
  "$defs": {
    "stream": {
      "type": "object",
      "required": ["path", "sha256", "retained_bytes", "truncated"],
      "properties": {
        "path": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "retained_bytes": {"type": "integer", "minimum": 0},
        "truncated": {"type": "boolean"}
      }
    }
  }
}
