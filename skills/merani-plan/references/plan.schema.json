{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shoti/merani/schemas/planning-plan-v1.json",
  "title": "Merani structured implementation plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "schema_version",
    "draft_revision",
    "request_sha256",
    "context_sha256",
    "evidence_sha256",
    "plan_kind",
    "goal",
    "acceptance_scenarios",
    "reproduction",
    "root_cause_confidence",
    "non_goals",
    "constraints",
    "current_architecture",
    "chosen_design",
    "alternatives",
    "invariants",
    "claims",
    "tasks",
    "traceability",
    "verification_commands",
    "rollout_and_rollback",
    "documentation_and_git",
    "open_questions",
    "refresh_instructions",
    "fresh_session_prompt",
    "created_at"
  ],
  "properties": {
    "artifact_type": {"const": "planning_plan"},
    "schema_version": {"const": 1, "type": "integer"},
    "draft_revision": {"type": "string"},
    "request_sha256": {"$ref": "#/$defs/sha256"},
    "context_sha256": {"$ref": "#/$defs/sha256"},
    "evidence_sha256": {"$ref": "#/$defs/sha256"},
    "plan_kind": {"enum": ["feature", "bug-fix"]},
    "goal": {"type": "string", "minLength": 1},
    "acceptance_scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "reproduction": {"type": ["string", "null"]},
    "root_cause_confidence": {
      "enum": ["low", "medium", "high", null]
    },
    "non_goals": {"$ref": "#/$defs/strings"},
    "constraints": {"$ref": "#/$defs/strings"},
    "current_architecture": {"type": "string", "minLength": 1},
    "chosen_design": {"type": "string", "minLength": 1},
    "alternatives": {"$ref": "#/$defs/strings"},
    "invariants": {"$ref": "#/$defs/strings"},
    "claims": {
      "type": "array",
      "items": {"$ref": "#/$defs/claim"}
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/task"}
    },
    "traceability": {
      "type": "array",
      "items": {"$ref": "#/$defs/traceability"}
    },
    "verification_commands": {
      "type": "array",
      "items": {"$ref": "#/$defs/verification"}
    },
    "rollout_and_rollback": {"type": "string"},
    "documentation_and_git": {"type": "string"},
    "open_questions": {"$ref": "#/$defs/strings"},
    "refresh_instructions": {"$ref": "#/$defs/strings"},
    "fresh_session_prompt": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "strings": {"type": "array", "items": {"type": "string"}},
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "new"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "symbol": {"type": ["string", "null"]},
        "new": {"type": "boolean"}
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "statement",
        "classification",
        "supporting_evidence",
        "contradicting_evidence",
        "rationale",
        "blocking"
      ],
      "properties": {
        "id": {"type": "string"},
        "statement": {"type": "string"},
        "classification": {
          "enum": ["observed", "inferred", "assumed", "unknown"]
        },
        "supporting_evidence": {"$ref": "#/$defs/strings"},
        "contradicting_evidence": {"$ref": "#/$defs/strings"},
        "rationale": {"type": "string"},
        "blocking": {"type": "boolean"}
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "depends_on",
        "requirements",
        "evidence",
        "repository_id",
        "locations",
        "change",
        "protected_invariants",
        "verification",
        "completion_criteria",
        "rollback"
      ],
      "properties": {
        "id": {"type": "string"},
        "title": {"type": "string"},
        "depends_on": {"$ref": "#/$defs/strings"},
        "requirements": {"$ref": "#/$defs/strings"},
        "evidence": {"$ref": "#/$defs/strings"},
        "repository_id": {"type": "string"},
        "locations": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/location"}
        },
        "change": {"type": "string"},
        "protected_invariants": {"$ref": "#/$defs/strings"},
        "verification": {"type": "string"},
        "completion_criteria": {"type": "string"},
        "rollback": {"type": "string"}
      }
    },
    "traceability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criterion_id", "task_ids", "verification"],
      "properties": {
        "criterion_id": {"type": "string"},
        "task_ids": {"$ref": "#/$defs/strings"},
        "verification": {"type": "string"}
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "repository_id", "working_directory", "command", "expected_outcome"],
      "properties": {
        "id": {"type": "string"},
        "repository_id": {"type": "string"},
        "working_directory": {"type": "string"},
        "command": {"type": "string", "minLength": 1},
        "expected_outcome": {"type": "string", "minLength": 1}
      }
    }
  }
}
